# ============================================================
# 🧠 LLM & API Configuration (Google Gemini / OpenAI / Anthropic)
# ============================================================
# Multi-key pool: separate multiple keys with commas for automatic rotation
GEMINI_API_KEYS=your_gemini_api_key_1,your_gemini_api_key_2
GEMINI_MODEL=gemini-2.5-flash

# Optional: OpenAI / Anthropic fallback keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ============================================================
# 🕸️ Neo4j Knowledge Graph Database
# ============================================================
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphsheet_secure_pass_2026
NEO4J_AUTH=neo4j/graphsheet_secure_pass_2026

# ============================================================
# 🌐 Google Workspace OAuth Credentials (Optional for Drive/Sheets)
# ============================================================
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# ============================================================
# 🛡️ Sandbox & Storage Configuration
# ============================================================
ENERGY_DB_PATH=/srv/backend/app/storage/.energy.db
SANDBOX_DOCKER_IMAGE=ai-dashboard-sandbox
STORAGE_PATH=/srv/backend/app/storage

# ============================================================
# 💻 Frontend & Networking
# ============================================================
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Optional: Cloudflare Tunnel Token for public secure access
TUNNEL_TOKEN=
