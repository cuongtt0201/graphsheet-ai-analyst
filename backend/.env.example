GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=

# Single key (backward compatible)
GEMINI_API_KEY=
NVIDIA_API_KEY=

# Optional: extra free-tier keys, comma-separated, to multiply quota.
# The router pools every model x every key as an independent slot and rotates
# across them, parking any slot that hits a rate limit.
# GEMINI_API_KEYS=key2,key3
# NVIDIA_API_KEYS=key2,key3

# Graph memory (user profile + habits/recipes/skills). Optional: if unset or
# unreachable, memory features degrade silently and the app works as before.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
