# Image for the code-execution sandbox (sibling containers spawned by
# app/agent/sandbox.py). Build once:
#   docker build -f Dockerfile.sandbox -t ai-dashboard-sandbox .
# Override the tag via SANDBOX_IMAGE if you use a different name.
FROM python:3.11-slim

# Quote every spec: RUN uses /bin/sh, which reads the ">" in "pandas>=2.2.0" as
# an output redirection. Unquoted, this installed bare "pandas numpy pyarrow"
# with no lower bound at all and left two junk files ("=2.2.0", "=15.0.0") in /.
RUN pip install --no-cache-dir "pandas>=2.2.0" numpy "pyarrow>=15.0.0"
