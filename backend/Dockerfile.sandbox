# Image for the code-execution sandbox (sibling containers spawned by
# app/agent/sandbox.py). Build once:
#   docker build -f Dockerfile.sandbox -t ai-dashboard-sandbox .
# Override the tag via SANDBOX_IMAGE if you use a different name.
FROM python:3.11-slim

# Pinned to the SAME versions the backend runs (see requirements.lock.txt).
# The backend builds a DataFrame, ships it here as parquet, and reads the result
# back; if the two pandas differ, a dtype or a groupby default can differ with
# it, and the numbers the user is shown were computed under rules the backend
# never applied. Bump these together with the lock, never on their own.
#
# Quote every spec: RUN uses /bin/sh, which reads ">" in "pandas>=2.2.0" as an
# output redirection. Unquoted, this installed bare "pandas numpy pyarrow" with
# no version constraint at all and left two junk files ("=2.2.0", "=15.0.0") in /.
RUN pip install --no-cache-dir "pandas==3.0.5" "numpy==2.4.6" "pyarrow==25.0.1"
